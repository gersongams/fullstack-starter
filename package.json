{
  "name": "fullstack-starter",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint typecheck",
    "format:check": "turbo run format:check",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "lefthook": "^2.1.14",
    "turbo": "^2.11.3"
  }
}
