# Copy to .env.local and fill in. Never commit real secrets.

# Postgres (same database as the API; Better Auth uses the "auth" schema).
DATABASE_URL=postgres://starter:starter@localhost:54320/starter

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app. Also the JWT issuer the Go API expects.
BETTER_AUTH_URL=http://localhost:3100

# Outgoing mail (email verification, password reset). `make db-up` starts
# Mailpit, which catches everything: read it at http://localhost:18025.
# Production: your provider's SMTP endpoint, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=smtp://localhost:10025
MAIL_FROM=Fullstack Starter <no-reply@localhost>

# true: no session until the email address is confirmed. Recommended in production.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Production only. The rate limiter keys on the client address, read from
# x-forwarded-for unless you name the header your proxy or CDN sets and
# overwrites (cf-connecting-ip, x-vercel-forwarded-for, x-real-ip, ...), and/or
# list the proxies to skip in a forwarded chain. See docs/authentication.md.
# AUTH_IP_HEADER=
# AUTH_TRUSTED_PROXIES=

# Tracing is off until an OTLP endpoint is set (same switch as the API).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Where Next.js forwards /api/v1/* (read at build time by next.config.ts).
API_INTERNAL_URL=http://localhost:8787
# JWT audience the Go API expects (AUTH_AUDIENCE on the API side).
API_JWT_AUDIENCE=starter-api
