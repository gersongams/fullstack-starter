{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "start:standalone": "sh scripts/start-standalone.sh",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:generate": "openapi-ts",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/auth/dist/index.mjs migrate --yes --config src/lib/auth.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/otel": "^2.1.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.12",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.1"
}
