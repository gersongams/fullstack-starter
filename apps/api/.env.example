# Copy to .env for local development. `make dev-api` loads it.
APP_ENV=development
LOG_LEVEL=debug
PORT=8787
# Apply pending API migrations when the server starts. Default: true in
# development, false in production (where `api migrate` is a release step).
# Instances starting together take turns on a Postgres advisory lock.
# Better Auth's tables still need `make migrate` after upgrading Better Auth.
MIGRATE_ON_START=true
# Requests per minute allowed per caller address and per signed-in user. 0 disables.
RATE_LIMIT_PER_MINUTE=300
# memory: each API instance counts on its own. postgres: instances share one limit.
RATE_LIMIT_STORE=memory
# Networks whose X-Forwarded-For is believed when rate limiting by client
# address. Next.js forwards the browser's own X-Forwarded-For unchanged and
# adds nothing, so list the web app here ONLY when a load balancer or CDN in
# front of it appends the real client address. Otherwise leave it empty: the
# header would be whatever the browser sent.
# TRUSTED_PROXIES=10.0.0.0/8
DATABASE_URL=postgres://starter:starter@localhost:54320/starter?sslmode=disable

# Tracing is off until an OTLP endpoint is set. All standard OTEL_* variables apply.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Must match the Better Auth JWT plugin settings in apps/web.
AUTH_JWKS_URL=http://localhost:3100/api/auth/jwks
AUTH_ISSUER=http://localhost:3100
AUTH_AUDIENCE=starter-api
